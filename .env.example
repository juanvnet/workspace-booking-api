# Copy this file to .env and change the values:  cp .env.example .env
# The real .env file is never committed to git

# PostgreSQL container created by docker compose
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking

# Database used when running the API on your machine with uvicorn (the PostgreSQL container).
# With docker compose this value is replaced by the PostgreSQL container (see docker-compose.yml).
# If you change the PostgreSQL values above, change them here too.
DATABASE_URL=postgresql+psycopg://booking:change-me@localhost:5432/booking

# Database used by the tests. Its name must end with "_test" because the tests delete its tables.
TEST_DATABASE_URL=postgresql+psycopg://booking:change-me@localhost:5432/booking_test

# Key used to sign the JWT tokens. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

MIN_BOOKING_MINUTES=5
MAX_BOOKING_HOURS=8
CORS_ORIGINS=["http://localhost:3000"]

# Admin account created automatically when the API starts (only if it does not exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password