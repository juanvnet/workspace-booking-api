# Copy this file to .env and change the values:  cp .env.example .env
# The real .env file is never committed to git

# PostgreSQL container created by docker compose
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booking

# Connection used by the API. "db" is the name of the PostgreSQL service in docker-compose.yml
# To run the API without Docker, you can use SQLite instead:  DATABASE_URL=sqlite:///./booking.db
DATABASE_URL=postgresql+psycopg://booking:change-me@db:5432/booking

# Key used to sign the JWT tokens. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_BOOKING_HOURS=8
CORS_ORIGINS=["http://localhost:3000"]

# Admin account created automatically when the API starts (only if it does not exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password